# WRC scraper configuration contract.
#
# Every operational value is env-driven (no hardcoded values). Copy to `.env`
# and adjust as needed:  cp .env.example .env
#
# Docker Compose auto-loads `.env` for the service credentials/ports below. For
# the Python app, export these into the environment before running, e.g.:
#     set -a; source .env; set +a
# All values shown are the built-in defaults, so an empty/absent .env behaves
# exactly like the committed defaults.

# ---------------------------------------------------------------------------
# Storage: MongoDB (metadata) -- connection string, database, collection
# ---------------------------------------------------------------------------
WRC_MONGO_URI=mongodb://localhost:27017
WRC_MONGO_DATABASE=wrc
WRC_MONGO_COLLECTION=landing_metadata
# Host port Compose publishes MongoDB on (must match WRC_MONGO_URI).
WRC_MONGO_PORT=27017
WRC_MONGO_IMAGE=mongo:7

# ---------------------------------------------------------------------------
# Storage: MinIO (object storage) -- endpoint, credentials, bucket
# ---------------------------------------------------------------------------
WRC_MINIO_ENDPOINT=localhost:9000
WRC_MINIO_ACCESS_KEY=minioadmin
WRC_MINIO_SECRET_KEY=minioadmin
WRC_MINIO_BUCKET=wrc-landing
WRC_MINIO_SECURE=false
# Host ports Compose publishes MinIO API/console on (API must match WRC_MINIO_ENDPOINT).
WRC_MINIO_PORT=9000
WRC_MINIO_CONSOLE_PORT=9001
WRC_MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z

# ---------------------------------------------------------------------------
# Docker Compose only -- host ports/UI credentials for the containerized stack
# (docker-compose.yml). These are NOT read by the Python app; they only
# parameterize Compose. All have built-in defaults, so an empty/absent .env
# behaves exactly like the committed defaults.
# ---------------------------------------------------------------------------
# Host port the `app` service publishes the Dagster UI on.
WRC_DAGSTER_UI_PORT=3000
# Optional mongo-express metadata browser (opt-in `tools` profile:
# `docker compose --profile tools up -d mongo-express`). Host port + basic-auth
# for the UI itself. Dev-only defaults -- override for anything beyond local use.
WRC_MONGO_EXPRESS_PORT=8081
WRC_MONGO_EXPRESS_USER=admin
WRC_MONGO_EXPRESS_PASSWORD=admin

# ---------------------------------------------------------------------------
# Partitioning (partition size) -- see docs/SCRAPY_EXPERIMENTS.md Sec 16
# ---------------------------------------------------------------------------
WRC_PARTITION_UNIT=months          # months | days
WRC_PARTITION_COUNT=1

# ---------------------------------------------------------------------------
# Scraping target
# ---------------------------------------------------------------------------
WRC_SEARCH_URL=https://www.workplacerelations.ie/en/search/
# Defaults to the search URL's own domain if unset; comma-separated.
# WRC_ALLOWED_DOMAINS=workplacerelations.ie
WRC_USER_AGENT=wrc_scraper (Kedra coding assessment; contact: jinanrachid@gmail.com)
# Deliberately false -- the site's real (lowercase) links are ALLOWED by its
# robots.txt parser; see docs/SCRAPY_EXPERIMENTS.md robots.txt section.
WRC_ROBOTSTXT_OBEY=false
# Twisted reactor, pinned explicitly so the crawl is deterministic across Scrapy
# versions (rather than inheriting Scrapy's version-dependent default). The
# asyncio-backed reactor is the right choice for async/await interop; only
# change this if you have a specific reason to.
WRC_TWISTED_REACTOR=twisted.internet.asyncioreactor.AsyncioSelectorReactor

# ---------------------------------------------------------------------------
# Concurrency / throttling. Sec 15 ramp measured 24 optimal under good latency;
# default revised to 16 + 60s timeout (Sec 21) for robustness under variable
# WRC latency, where 24/30 produced timeout noise. Raise to 24 for max throughput
# when the site is responsive.
# ---------------------------------------------------------------------------
WRC_CONCURRENT_REQUESTS=16
# Defaults to WRC_CONCURRENT_REQUESTS if unset (single-domain crawl).
# WRC_CONCURRENT_REQUESTS_PER_DOMAIN=16
WRC_DOWNLOAD_DELAY=0.0
WRC_AUTOTHROTTLE_ENABLED=true
WRC_AUTOTHROTTLE_START_DELAY=0.25
WRC_AUTOTHROTTLE_MAX_DELAY=10
# Average parallel requests AutoThrottle steers toward (WRC_CONCURRENT_REQUESTS
# stays the hard ceiling above this). Kept low deliberately: this server
# degrades under load, and higher targets produced timeouts. Raise toward
# WRC_CONCURRENT_REQUESTS for more throughput when the site is responsive.
WRC_AUTOTHROTTLE_TARGET_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Reliability
# ---------------------------------------------------------------------------
WRC_RETRY_ENABLED=true
WRC_RETRY_TIMES=5
WRC_RETRY_HTTP_CODES=429,500,502,503,504,408,522,524
WRC_DOWNLOAD_TIMEOUT=60
WRC_DOWNLOAD_MAXSIZE=52428800      # 50 MiB; 0 would mean unbounded (avoided)
# Safety ceiling on pages fetched per (body, partition) -- not a real limit.
# docs/SCRAPY_EXPERIMENTS.md Sec 23 verified pageNumber is respected and the
# largest real WRC partition (234 records) needs 24 pages; this default gives
# ~20x headroom and should never bind on a normal WRC partition.
WRC_MAX_PAGES=500

# ---------------------------------------------------------------------------
# Misc hardening / behavior
# ---------------------------------------------------------------------------
WRC_COOKIES_ENABLED=false
WRC_TELNETCONSOLE_ENABLED=false
# Skip re-downloading unchanged binaries via conditional GET (assessment req #9).
WRC_CONDITIONAL_GET=true

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
WRC_LOG_LEVEL=INFO
# If set, structured JSON events are written here (JSON lines) instead of stdout.
# WRC_EVENTS_LOG_FILE=events.jsonl

# ---------------------------------------------------------------------------
# Transformation (Phase 4) -- same Mongo database / MinIO endpoint as above,
# a different collection/bucket. See docs/SCRAPY_EXPERIMENTS.md Sec 22.
# ---------------------------------------------------------------------------
WRC_MONGO_TRANSFORMED_COLLECTION=transformed_metadata
WRC_MINIO_TRANSFORMED_BUCKET=wrc-transformed
# Drop all <img> from cleaned HTML (the only images observed inside div.content
# are invisible 1x1 layout spacers). Set true to keep images instead (src
# rewritten to an absolute URL).
WRC_TRANSFORM_KEEP_IMAGES=false
# Variant-cluster canonical selection: candidates whose cleaned content length
# differs by at most this many characters are logged as an ambiguous near-tie.
WRC_TRANSFORM_NEAR_TIE_CHARS=50
# Bounded thread-pool size for processing independent (body_slug, identifier)
# groups concurrently (I/O-bound: Mongo + MinIO reads/writes, HTML parsing).
# 1 disables the pool and runs fully sequentially.
WRC_TRANSFORM_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Orchestration (Phase 5, wrc_scraper/orchestration/) -- Dagster asset checks
# and partition-level retries.
# ---------------------------------------------------------------------------
# landing_documents/processed_documents quality-check thresholds: the fraction
# of found records that may fail before the check flags the partition (WARN),
# on top of -- not instead of -- the hard failure raised for a systemic
# crawl/transform error (e.g. finish_reason != "finished").
WRC_INGEST_FAILED_RATIO_THRESHOLD=0.05
WRC_TRANSFORM_FAILED_RATIO_THRESHOLD=0.05
# Partition-level RetryPolicy (exponential backoff + jitter). A transient
# failure (subprocess crash, momentary Mongo/MinIO outage) retries only that
# one partition -- safe because storage is idempotent.
WRC_ORCHESTRATION_RETRY_MAX=3
WRC_ORCHESTRATION_RETRY_DELAY_SECONDS=30
# Max concurrent partition runs during a Dagster backfill (QueuedRunCoordinator
# max_concurrent_runs in .dagster_home/dagster.yaml -- consumed by Dagster's
# instance config, not the Python app). Each run spawns its own `scrapy crawl`
# with its own WRC_CONCURRENT_REQUESTS pool, so total load ~= this x
# WRC_CONCURRENT_REQUESTS (default 4 x 16). Raise for more parallel partitions;
# lower WRC_CONCURRENT_REQUESTS if you do, to keep total load sane. NOTE: a host
# `dagster dev` run must have this exported (source .env) -- Dagster's env
# substitution has no inline default; the Docker image/Compose supply the 4.
WRC_DAGSTER_MAX_CONCURRENT_RUNS=4
# Hard ceiling on the `scrapy crawl` subprocess itself (scrapy_runner.py), on
# top of -- not instead of -- Scrapy's own per-request DOWNLOAD_TIMEOUT/
# RETRY_TIMES. Guards against a reactor deadlock or pre-request-timeout hang
# blocking a Dagster run/step slot forever.
WRC_SCRAPY_SUBPROCESS_TIMEOUT_SECONDS=3600
